{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{schema.sql,templates/admin.html}"
    }
  },
  "routes": [
    { "src": "^/admin(\\.html)?/?$", "dest": "/api/admin-page" },
    { "src": "^/api/admin/applications/?$", "dest": "/api/admin-applications" },
    { "src": "^/api/admin/review/?$", "dest": "/api/admin-review" },
    { "src": "^/(templates|lib|node_modules)(/.*)?$", "status": 404 },
    { "src": "^/(server\\.js|db\\.js|schema\\.sql|package\\.json|package-lock\\.json)$", "status": 404 }
  ]
}
